rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Public images (outlets & products)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Private licence documents (Non-public)
    match /licences/{vendorId}/{document} {
      allow read: if request.auth != null && (request.auth.uid == vendorId || request.auth.token.role == 'compliance_officer');
      allow write: if request.auth != null && request.auth.uid == vendorId;
    }
  }
}
